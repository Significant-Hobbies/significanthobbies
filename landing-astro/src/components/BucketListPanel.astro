---
const famous = [
  {
    name: 'Will Smith',
    slug: 'will-smith',
    img: '/categories/creative-800.webp',
    preview: 'Skydive over the Dubai desert',
  },
  {
    name: 'Barack Obama',
    slug: 'barack-obama',
    img: '/categories/intellectual-800.webp',
    preview: 'Visit every US national park',
  },
  {
    name: 'Serena Williams',
    slug: 'serena-williams',
    img: '/categories/physical-800.webp',
    preview: 'Start a foundation for girls',
  },
];
---

<section class="border-y border-border bg-[#ffd0bd] px-6 py-28 lg:px-12 lg:py-36">
  <div class="mx-auto max-w-6xl">
    <div class="grid gap-8 lg:grid-cols-[1fr_auto] lg:items-end">
      <div class="max-w-3xl">
        <h2
          class="font-serif text-4xl font-medium tracking-tight text-foreground sm:text-5xl lg:text-6xl"
          style="line-height: 1.02;"
        >
          What will you do before you die?
        </h2>
        <p class="mt-5 max-w-2xl text-lg leading-relaxed text-muted-foreground">
          Twelve remarkable people wrote theirs down. Borrow an idea, reject the obvious,
          then make a list that could only belong to you.
        </p>
      </div>
      <a
        href="/bucket-lists"
        class="inline-flex min-h-11 items-center gap-2 border-b border-primary pb-1 text-sm font-semibold text-primary no-underline transition-colors hover:text-foreground focus-visible:ring-2 focus-visible:ring-primary focus-visible:ring-offset-4 focus-visible:ring-offset-card focus-visible:outline-none"
      >
        Browse every list <span aria-hidden="true">→</span>
      </a>
    </div>

    <div class="mt-14 grid gap-px overflow-hidden bg-border sm:grid-cols-3">
      {
        famous.map((person) => (
          <a
            href={`/bucket-lists/${person.slug}`}
            class="group relative block min-h-[28rem] overflow-hidden bg-background no-underline sm:min-h-[32rem]"
          >
            <img
              src={person.img}
              alt={`${person.name}'s bucket list`}
              loading="lazy"
              width="800"
              height="1000"
              class="absolute inset-0 h-full w-full object-cover transition-transform duration-700 ease-out group-hover:scale-[1.03]"
            />
            <div
              class="absolute inset-0"
              style="background: linear-gradient(to top, oklch(0.10 0.01 285 / 0.96) 0%, oklch(0.10 0.01 285 / 0.32) 62%, transparent 100%);"
            />
            <div class="absolute inset-x-0 bottom-0 p-6 sm:p-8">
              <p class="text-sm font-medium text-[#fff1a8]">{person.name}</p>
              <h3 class="mt-3 max-w-[18ch] font-serif text-2xl font-medium leading-tight text-white sm:text-3xl">
                “{person.preview}”
              </h3>
              <span class="mt-6 inline-flex min-h-11 items-center text-sm font-semibold text-white">
                View their list <span class="ml-2 transition-transform group-hover:translate-x-1" aria-hidden="true">→</span>
              </span>
            </div>
          </a>
        ))
      }
    </div>

    <p class="mt-8 text-sm text-muted-foreground">
      Need a nudge?
      <a
        href="/bucket-list-ideas"
        class="ml-1 font-semibold text-foreground underline decoration-border underline-offset-4 transition-colors hover:text-primary focus-visible:ring-2 focus-visible:ring-primary focus-visible:outline-none"
      >
        Explore 150+ ideas.
      </a>
    </p>
  </div>
</section>
