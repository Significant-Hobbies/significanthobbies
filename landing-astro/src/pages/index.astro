---
import Layout from '@/layouts/Layout.astro';

const TITLE = 'Significant Hobbies — Personal Apps';
const DESCRIPTION =
  'A simple directory for Live, Journal, Habits, Calorie, Setline, Kith, and Anchor.';

type Product = {
  name: string;
  mark: string;
  description: string;
  platforms: string;
  status: string;
  href?: string;
  color: string;
};

const products: Product[] = [
  {
    name: 'Live',
    mark: 'L',
    description: 'A lifelong catalog for places, hobbies, side quests, and experiences.',
    platforms: 'Web',
    status: 'Available now',
    href: '/live-more',
    color: '#fff09a',
  },
  {
    name: 'Journal',
    mark: 'J',
    description: 'A private page for morning, evening, and everything worth remembering.',
    platforms: 'iPhone · iPad',
    status: 'Native app prepared',
    color: '#eadcf6',
  },
  {
    name: 'Habits',
    mark: 'H',
    description: 'Keep what helps, trade what does not, and remember the choices you made.',
    platforms: 'iPhone · iPad',
    status: 'Native app prepared',
    color: '#dceeff',
  },
  {
    name: 'Calorie',
    mark: 'C',
    description: 'A private food, water, medicine, and weight journal.',
    platforms: 'Web · Apple',
    status: 'Web app available',
    href: 'https://calorie.significanthobbies.com',
    color: '#e4efd9',
  },
  {
    name: 'Setline',
    mark: 'S',
    description: 'A personal record for the practice and progress that matter to you.',
    platforms: 'Apple',
    status: 'Native app in preparation',
    href: 'https://setline.significanthobbies.com',
    color: '#f5e2d2',
  },
  {
    name: 'Kith',
    mark: 'K',
    description: 'A private place for the people you want to keep close.',
    platforms: 'iPhone',
    status: 'Native app in preparation',
    href: 'https://kith.significanthobbies.com',
    color: '#f6e1d4',
  },
  {
    name: 'Anchor',
    mark: 'A',
    description: 'See where your time went, including the interruptions around it.',
    platforms: 'Mac · iPhone · Watch',
    status: 'Native app in preparation',
    href: 'https://anchor.significanthobbies.com',
    color: '#dce8f0',
  },
];
---

<Layout title={TITLE} description={DESCRIPTION}>
  <main id="main" class="hub">
    <header class="hub__header">
      <a class="hub__wordmark" href="/">Significant Hobbies</a>
      <p class="hub__kicker">Personal apps</p>
      <h1>Your personal apps, in one place.</h1>
      <p class="hub__lede">
        Seven focused products. Each stays useful on its own. This Hub is the simple front door.
      </p>
    </header>

    <section aria-labelledby="products-heading" class="collection">
      <div class="collection__heading">
        <h2 id="products-heading">The collection</h2>
        <p>Directory now. Shared summaries later.</p>
      </div>

      <div class="product-grid">
        {products.map((product) => {
          const Tag = product.href ? 'a' : 'article';
          return (
            <Tag
              class:list={['product-card', { 'product-card--linked': product.href }]}
              href={product.href}
              style={`--card-color: ${product.color}`}
            >
              <div class="product-card__top">
                <span class="product-card__mark" aria-hidden="true">{product.mark}</span>
                {product.href && <span aria-hidden="true">↗</span>}
              </div>
              <div>
                <h3>{product.name}</h3>
                <p class="product-card__description">{product.description}</p>
                <div class="product-card__meta">
                  <strong>{product.platforms}</strong>
                  <span>{product.status}</span>
                </div>
              </div>
            </Tag>
          );
        })}
      </div>
    </section>

    <aside class="hub-note">
      <div>
        <strong>No combined database yet.</strong>
        <p>Each product still owns its interface and data. Connections come after the split is stable.</p>
      </div>
      <span>Read-only Hub</span>
    </aside>

    <footer class="hub__footer">
      <span>© 2026 Significant Hobbies</span>
      <nav aria-label="Footer">
        <a href="/privacy">Privacy</a>
        <a href="/about">About</a>
      </nav>
    </footer>
  </main>
</Layout>
