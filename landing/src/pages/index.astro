---
import Base from "@saas-maker/templates/Base.astro";
import { GalleryPage } from "@saas-maker/templates/gallery-page";
import { baseProps } from "@saas-maker/templates/page";
import { galleryContent } from "@saas-maker/templates/schema";
import { studioFromProjects, studioProjectsFeed } from "@saas-maker/ui/blocks/footer";
import json from "../content/home.json";

const content = galleryContent.parse(json);
const projects = await fetch(studioProjectsFeed, { signal: AbortSignal.timeout(3000) })
  .then((r) => r.ok ? r.json() : [])
  .catch(() => []);
if (content.footer) content.footer.studio = studioFromProjects(projects, { current: "significanthobbies" });
---

<Base {...baseProps(content)}>
  <Fragment slot="head">
    <meta name="theme-color" content="#f2efe6" />
    <script is:inline defer src="https://health.sassmaker.com/tracker.js" data-key="ahk_pub_b3a9b36eb3c54352f662f03601aebe77767b86c09f57a1f5d3a3268c48b285f9" data-project="app-2b8f1fb8-2c1e-4456-a0aa-77033a978cfc" data-identity="persistent" data-endpoint="https://ingest.sassmaker.com/v1/browser"></script>
    <script is:inline>(function(c,l,a,r,i,t,y){c[a]=c[a]||function(){(c[a].q=c[a].q||[]).push(arguments)};t=l.createElement(r);t.async=1;t.src="https://www.clarity.ms/tag/y6btx9iks3";y=l.getElementsByTagName(r)[0];y.parentNode.insertBefore(t,y);})(window,document,"clarity","script","y6btx9iks3");window.clarity("set","project_id","significanthobbies");</script>
    <script is:inline>
      document.addEventListener("DOMContentLoaded", function () {
        const events = {"/hub":"hub_opened","#apps":"apps_explored","https://live.significanthobbies.com":"live_opened","https://calorie.significanthobbies.com":"calorie_opened","https://setline.significanthobbies.com":"setline_opened","https://kith.significanthobbies.com":"kith_opened","https://anchor.significanthobbies.com":"anchor_opened"};
        document.querySelectorAll("a[href]").forEach(function (link) {
          const name = events[link.getAttribute("href")];
          if (name) link.setAttribute("data-app-health-event", name);
        });
      });
    </script>
    <script is:inline>document.addEventListener("click",function(event){const action=event.target.closest&&event.target.closest("[data-app-health-event]");const name=action&&action.getAttribute("data-app-health-event");if(!name||!window.appHealth||typeof window.appHealth.track!=="function")return;const modified=event.button!==0||event.metaKey||event.ctrlKey||event.shiftKey||event.altKey||action.target==="_blank";const destination=new URL(action.href,location.href);const sameDocument=destination.origin===location.origin&&destination.pathname===location.pathname&&destination.search===location.search;window.appHealth.track(name);if(modified||sameDocument)return;event.preventDefault();window.appHealth.flush().finally(function(){location.assign(action.href)})},true);</script>
  </Fragment>
  <GalleryPage content={content} />
</Base>

<style is:global>
  /* Keep the shared Gallery blocks inside the Hub's ruled paper layout. */
  html[data-backdrop="grid"] body { background-size: min(8vw, 96px) 100%; }
  body > header, #main { max-width: 1320px; margin-inline: auto; }
  #main { border-inline: 1px solid var(--border); }
  #main > section { border-bottom: 1px solid var(--border); }
  .identity-hero[data-hero-layout="masthead"] {
    display: grid;
    grid-template-columns: minmax(150px, 1fr) minmax(0, 4.5fr);
    max-width: none;
    padding: 0;
  }
  .identity-issue {
    display: block;
    margin: 0;
    padding: 42px 32px;
    border-bottom: 0;
    border-right: 1px solid var(--border);
    text-transform: none;
  }
  .identity-issue span:first-child {
    display: block;
    max-width: 2ch;
    font-family: var(--font-display);
    font-size: clamp(2rem, 4vw, 4.5rem);
    line-height: .95;
    letter-spacing: -.04em;
    color: #77746a;
  }
  .identity-issue span:last-child { display: block; margin-top: 24px; font-size: .65rem; line-height: 1.6; letter-spacing: 0; }
  .identity-copy { padding: clamp(64px, 9vw, 126px) clamp(28px, 7vw, 100px) 72px; }
  [data-hero-layout="masthead"] h1 { font-size: clamp(3.5rem, 7vw, 7rem); line-height: .93; letter-spacing: -.055em; text-wrap: initial; overflow-wrap: normal; }
  .identity-eyebrow, #apps .ui-case, #connection .ui-case {
    font-family: var(--font-mono);
    font-size: .72rem;
    letter-spacing: .08em;
    color: #5d5a52;
  }
  .identity-lede { font-size: clamp(1.12rem, 1.55vw, 1.38rem); line-height: 1.62; }
  .identity-actions { gap: 10px; margin-top: 36px; }
  .identity-actions a, #product-truth a {
    min-height: 50px;
    height: auto;
    padding: 14px 19px;
    border: 1px solid var(--foreground);
    border-radius: 0;
    font-family: var(--font-sans);
    font-size: .82rem;
    letter-spacing: 0;
    color: var(--background);
    background: var(--foreground);
  }
  .identity-actions a + a { color: var(--foreground); background: transparent; }
  .identity-actions a:hover, #product-truth a:hover { background: var(--brand); border-color: var(--brand); color: var(--foreground); }
  .identity-note { max-width: 680px; margin-top: 28px; padding-left: 16px; border-left: 3px solid var(--brand); font-family: var(--font-sans); line-height: 1.55; }
  .identity-note span.inline-flex { display: inline; font-weight: 600; }
  .identity-note span.inline-flex > span, .identity-note > span[aria-hidden] { display: none; }
  #apps ul { gap: 0; border-top: 1px solid var(--border); border-left: 1px solid var(--border); }
  #apps li { padding: 24px; border-right: 1px solid var(--border); border-bottom: 1px solid var(--border); }
  #product-truth { min-height: 0; padding-block: clamp(70px, 8vw, 112px); background: #1c1c18; color: #f2efe6; }
  #product-truth > div[aria-hidden] { display: none; }
  #product-truth > div:not([aria-hidden]) { padding-top: 0; text-align: left; }
  #product-truth h2::before { content: "current product truth"; display: block; margin-bottom: 28px; font-family: var(--font-mono); font-size: .72rem; font-weight: 400; letter-spacing: .08em; color: #aaa69b; }
  #product-truth p { max-width: 710px; margin-inline: 0; color: #aaa69b; font-family: var(--font-sans); line-height: 1.6; }
  #product-truth a { border-color: #f2efe6; color: #1c1c18; background: #f2efe6; }
  #product-truth div:has(> a) { justify-content: flex-start; }
  @media (max-width: 900px) {
    .identity-hero[data-hero-layout="masthead"] { grid-template-columns: 96px minmax(0, 1fr); }
    .identity-issue { padding-inline: 20px; }
    .identity-issue span:last-child { overflow-wrap: anywhere; }
  }
  @media (max-width: 620px) {
    .identity-hero[data-hero-layout="masthead"] { display: block; }
    .identity-issue { display: flex; align-items: center; justify-content: space-between; padding: 24px 20px; border-right: 0; border-bottom: 1px solid var(--border); }
    .identity-issue span:first-child { max-width: none; font-size: 2rem; }
    .identity-issue span:last-child { margin-top: 0; }
    .identity-copy { padding: 52px 20px 58px; }
    [data-hero-layout="masthead"] h1 { font-size: clamp(3.15rem, 15.2vw, 4.8rem); }
    .identity-lede { font-size: 1.03rem; }
    .identity-actions { flex-direction: column; align-items: stretch; }
    .identity-actions a { justify-content: center; }
    #apps ul { grid-template-columns: minmax(0, 1fr); }
  }
</style>
