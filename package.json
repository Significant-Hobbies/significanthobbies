{
  "name": "significanthobbies",
  "version": "0.1.0",
  "private": true,
  "homepage": "https://significanthobbies.com",
  "scripts": {
    "dev": "next dev",
    "build": "next build --webpack && node scripts/run-inline-critical-css.mjs",
    "cf:build": "node scripts/cf-build.mjs && opennextjs-cloudflare populateCache local",
    "validate:env:deploy": "node scripts/validate-env.mjs deploy",
    "start": "next start",
    "preview": "opennextjs-cloudflare preview",
    "deploy": "pnpm validate:env:deploy && pnpm cf:build && wrangler deploy --minify --tag \"$(git rev-parse HEAD)\"",
    "lint": "biome check .",
    "typecheck": "tsc --noEmit",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "check": "biome check .",
    "content": "tsx scripts/content-cli.ts",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "db:migrate:local": "wrangler d1 migrations apply DB --local --config wrangler.local.toml",
    "db:migrate:remote": "wrangler d1 migrations apply DB --remote",
    "dev:test-auth": "ENABLE_TEST_AUTH=1 next dev",
    "db:generate": "drizzle-kit generate",
    "db:seed": "tsx prisma/seed.ts",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "docs:check": "node scripts/docs-check-links.mjs",
    "docs:build": "pnpm --filter significanthobbies-docs build",
    "docs:preview": "pnpm --filter significanthobbies-docs preview",
    "knip": "knip --no-exit-code --reporter symbols",
    "knip:strict": "knip --reporter symbols",
    "quality:astro": "pnpm --filter significanthobbies-landing-astro check",
    "quality:unused": "node scripts/check-code-health.mjs unused",
    "quality:complexity": "node scripts/check-code-health.mjs complexity",
    "quality:duplication:raw": "jscpd src ios/Sources scripts --min-lines 8 --min-tokens 60 --mode strict --ignore '**/*.test.*,**/node_modules/**,**/coverage/**,**/.next/**,**/out/**,**/dist/**' --threshold 100 --silent --no-tips",
    "quality:duplication": "node scripts/check-code-health.mjs duplication",
    "quality:cycles": "node scripts/check-code-health.mjs cycles",
    "quality:dependencies": "node scripts/check-code-health.mjs dependencies",
    "quality:suppressions": "node scripts/check-code-health.mjs suppressions",
    "quality:hygiene": "node scripts/check-code-health.mjs hygiene",
    "quality:native-format": "node scripts/check-code-health.mjs native-format",
    "quality:web": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm quality:astro && pnpm test:coverage && pnpm quality:unused && pnpm quality:complexity && pnpm quality:duplication && pnpm quality:cycles && pnpm quality:dependencies && pnpm quality:suppressions && pnpm docs:check && pnpm quality:hygiene",
    "quality:native": "pnpm quality:native-format && node scripts/check-native-code-health.mjs",
    "quality": "pnpm quality:web",
    "quality:all": "pnpm quality:web && pnpm quality:native",
    "prepare": "husky"
  },
  "dependencies": {
    "@dnd-kit/core": "6.3.1",
    "@dnd-kit/sortable": "10.0.0",
    "@dnd-kit/utilities": "3.2.2",
    "@radix-ui/react-avatar": "1.2.6",
    "@radix-ui/react-dialog": "1.1.23",
    "@radix-ui/react-dropdown-menu": "2.1.24",
    "@radix-ui/react-label": "2.1.15",
    "@radix-ui/react-slot": "1.3.3",
    "@saas-maker/feedback": "^0.4.0",
    "better-auth": "1.6.25",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "drizzle-orm": "0.45.2",
    "html-to-image": "1.11.13",
    "lucide-react": "1.27.0",
    "motion": "^12.42.2",
    "nanoid": "5.1.9",
    "next": "16.2.12",
    "next-themes": "0.4.6",
    "posthog-js": "^1.407.3",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "sonner": "2.0.7",
    "tailwind-merge": "3.6.0",
    "web-vitals": "^4.2.4",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@biomejs/biome": "2.5.5",
    "@opennextjs/cloudflare": "1.20.2",
    "@playwright/test": "1.62.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "25.6.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "19",
    "@vitest/coverage-v8": "4.1.10",
    "babel-plugin-react-compiler": "1.0.0",
    "beasties": "^0.3.5",
    "dotenv": "17.4.2",
    "drizzle-kit": "0.31.10",
    "husky": "9.1.7",
    "jscpd": "5.0.14",
    "jsdom": "29.1.1",
    "knip": "^6.29.0",
    "shadcn": "4.15.0",
    "sharp": "^0.35.3",
    "tailwindcss": "^4.3.3",
    "tsx": "4.23.1",
    "tw-animate-css": "1.4.0",
    "typescript": "6.0.3",
    "ultracite": "7.10.2",
    "vitest": "4.1.10",
    "wrangler": "4.114.0"
  },
  "packageManager": "pnpm@10.33.2"
}
